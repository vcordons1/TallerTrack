{
  "name": "tallertrack",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/mobile"
  ],
  "engines": {
    "node": ">=24.17.0 <25"
  },
  "scripts": {
    "db:tool:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/scripts/setup-flyway.ps1",
    "db:migrate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-flyway.ps1 migrate",
    "db:info": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-flyway.ps1 info",
    "db:validate": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/scripts/invoke-flyway.ps1 validate",
    "bootstrap:internal-user": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/scripts/bootstrap-internal-user.ps1",
    "bootstrap:demo-reception": "node apps/api/scripts/bootstrap-demo-reception.js",
    "test:db:foundation": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/foundation.integration.ps1",
    "test:db:i02": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/i02.integration.ps1",
    "test:db:i03": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/i03.integration.ps1",
    "test:db:g03b": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/g03b.integration.ps1",
    "test:db:t01": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/t01.integration.ps1",
    "test:db:auth": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File database/tests/auth.integration.ps1",
    "test:db:integration": "npm.cmd run test:db:foundation && npm.cmd run test:db:i02 && npm.cmd run test:db:i03 && npm.cmd run test:db:g03b && npm.cmd run test:db:t01 && npm.cmd run test:db:auth",
    "test:api:oracle": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File apps/api/test/oracle.integration.ps1"
  },
  "packageManager": "npm@11.13.0"
}
