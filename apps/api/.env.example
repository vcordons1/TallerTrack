# Development-only operating profile. These values are not validated production policy.
TT_PRIVATE_STORAGE_ROOT=.data/private-files
TT_EVIDENCE_MAX_FILE_BYTES=10485760
TT_EVIDENCE_MAX_PIXELS=25000000
TT_EVIDENCE_MAX_DIMENSION=8192
TT_EVIDENCE_MAX_FILES_PER_OPERATION=10
TT_EVIDENCE_MULTIPART_MAX_FIELDS=1
TT_EVIDENCE_MULTIPART_MAX_FIELD_BYTES=4096
TT_EVIDENCE_UPLOAD_MAX_REQUESTS=20
TT_EVIDENCE_UPLOAD_WINDOW_SECONDS=60
TT_EVIDENCE_UPLOAD_BUCKET_CAPACITY=5000
TT_UPLOAD_RECEIPT_TTL_SECONDS=900

# Generate at least 32 random bytes and provide canonical base64 outside source control.
TT_UPLOAD_RECEIPT_HMAC_KEY_BASE64=<set-locally>

# TT-020 internal-authentication development profile; production calibration remains G-04.
TT_AUTH_ACCESS_TTL_SECONDS=600
TT_AUTH_SESSION_TTL_SECONDS=43200
TT_AUTH_REFRESH_TTL_SECONDS=43200
TT_AUTH_LOGIN_MAX_ATTEMPTS=5
TT_AUTH_LOGIN_WINDOW_SECONDS=900
TT_AUTH_LOGIN_BUCKET_CAPACITY=5000
TT_AUTH_HASH_MAX_CONCURRENCY=4
TT_AUTH_ISSUER=tallertrack-local
TT_AUTH_AUDIENCE=tallertrack-api

# Generate at least 32 random bytes and provide canonical base64 outside source control.
TT_AUTH_SIGNING_KEY_BASE64=<set-locally>
